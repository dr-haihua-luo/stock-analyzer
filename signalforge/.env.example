# Environment variables for SignalForge

# OpenRouter API Key (for LLM)
OPENROUTER_API_KEY=[your key]


# Database
POSTGRES_SERVER=localhost
POSTGRES_USER=signalforge
POSTGRES_PASSWORD=[your password]
POSTGRES_DB=signalforge
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Sync database URL for alembic migrations (local development)
DATABASE_URL_SYNC=postgresql://signalforge:signalforge_pass@localhost:5432/signalforge
REDIS_PASSWORD=

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend (for reference)
FRONTEND_PORT=5173
APCA_API_KEY_ID=[your key]
APCA_API_SECRET_KEY=[your secret]

# TipRanks MCP API (free tier — 5 req/min, 50 req/month)
# Provides analyst ratings, price targets, and consensus for stocks.
# Get your free API key from: https://mcp.tipranks.com
TIPRANKS_API_KEY=[your key]